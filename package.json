{
  "name": "spendlog",
  "version": "0.1.0",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:RyzeInc/tallyup.git"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-env.js",
    "build": "next build",
    "start": "next start",
    "check": "npm run lint && npm run type:convex",
    "type:convex": "tsc -p convex/tsconfig.json --noEmit",
    "lint": "eslint",
    "test": "vitest",
    "pwa:generate-icons": "node scripts/generate-icons.mjs",
    "pwa:test": "npm run build && npm start"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.64",
    "@clerk/nextjs": "^6.36.10",
    "ai": "^6.0.62",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.31.6",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.563.0",
    "next": "16.1.1",
    "plaid": "^41.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-plaid-link": "^4.1.1",
    "recharts": "^3.7.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/estree": "^1.0.8",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.19.30",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "^16.1.4",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "rimraf": "^4.0.3",
    "glob": "^9.3.5",
    "@xmldom/xmldom": "^0.9.0",
    "@npmcli/move-file": "^2.0.1",
    "inflight": "^1.0.6"
  }
}
