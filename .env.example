# ---------------------------------------------------------------------------
# TallyUp environment variables
# Copy to .env.local and fill in. Nothing here is secret by itself.
# ---------------------------------------------------------------------------

# --- Convex (required) -----------------------------------------------------
# From `npx convex dev` or the Convex dashboard.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# --- Clerk (required) ------------------------------------------------------
# Clerk dashboard -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Where Clerk sends users. These match app/sign-in and app/sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---------------------------------------------------------------------------
# Convex deployment environment (set with `npx convex env set`, NOT in .env.local)
# ---------------------------------------------------------------------------
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
#
# --- Coach / LLM -----------------------------------------------------------
# The coach falls back to a canned mock provider unless BOTH of these are set:
#   LLM_ENABLED=true  AND  ALPHA_COST_GUARD=false
# LLM_ENABLED=true
# ALPHA_COST_GUARD=false
# LLM_PROVIDER=openai            # openai | groq | cloudflare | mock
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_MODEL=gpt-4o-mini
# GROQ_API_KEY=gsk_xxxxxxxx
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
#
# --- Plaid -----------------------------------------------------------------
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox              # sandbox | development | production
